<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_lr</left_joint>
      <left_joint>wheel_lm</left_joint>
      <left_joint>wheel_lf</left_joint>

      <right_joint>wheel_rr</right_joint>
      <right_joint>wheel_rm</right_joint>
      <right_joint>wheel_rf</right_joint>


      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/mux/cmd_vel</topic>
    </plugin>
  </gazebo>





  <gazebo reference="$(arg camera_name)_camera_link">
    <pose>0 0 0 0 0 0</pose>
    <sensor name="camera_left" type="camera">
      <ignition_frame_id>$(arg camera_name)_camera_link</ignition_frame_id>
      <pose>0.0 0.06 0 0 0 0</pose>
      <update_rate>30</update_rate>
      <topic>/zed2/zed_node/left/image_rect_color</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <camera_info>
        <topic>/zed2/zed_node/left/camera_info</topic>
      </camera_info>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>

    <sensor name="camera_right" type="camera">
      <ignition_frame_id>$(arg camera_name)_camera_link</ignition_frame_id>
      <pose>0.0 -0.06 0 0 0 0</pose>
      <update_rate>30</update_rate>
      <topic>/zed2/zed_node/right/image_rect_color</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <camera_info>
        <topic>/zed2/zed_node/right/camera_info</topic>
      </camera_info>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>

    <sensor name="rgbd_camera" type="rgbd_camera">
      <ignition_frame_id>$(arg camera_name)_camera_link</ignition_frame_id>
      <pose>0.0 0.06 0 0 0 0</pose>
      <update_rate>30.0</update_rate>
      <topic>/zed2/zed_node/depth</topic>
      
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <!-- <width>1280</width>
          <height>720</height> -->
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>6.0</far>
        </clip>
      </camera>
      
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>

    <sensor name="imu_sensor" type="imu">
      <ignition_frame_id>$(arg camera_name)_camera_link</ignition_frame_id>
      <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
      </plugin>
    </sensor>
  </gazebo>






  <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>




  <gazebo>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>wheel_lr</joint_name>
      <joint_name>wheel_rr</joint_name>
      <joint_name>left_rocker_joint</joint_name>
      <joint_name>right_rocker_joint</joint_name>
      <joint_name>joint_left_l_u</joint_name>
      <joint_name>joint_right_l_u</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>