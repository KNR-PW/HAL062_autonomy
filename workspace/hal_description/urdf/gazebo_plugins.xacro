<?xml version="1.0"?>
<!--
  Gazebo (Jetty, gz-sim 10) part of the HAL-062 description: drive, joint states, sensors.
  Included by hal_062.urdf.xacro only when simulation:=true.

  World-level systems (Physics, Sensors, Imu, ...) live in the world SDF (hal_simulation/worlds),
  not here: loading them again from the robot would run them twice.
  Plugin names: gz-sim-*-system / gz::sim::systems::* (the libignition-gazebo-* names do not exist in Jetty).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="cam" value="$(arg camera_name)"/>

  <!-- ============================== DRIVE ============================== -->
  <!-- NOTE: wheel_separation / wheel_radius kept from the original (1.2 / 0.15);
       geometric values are ~0.93 (2 * (rocker_joint_y + wheel_y)) and 0.1586. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_lr</left_joint>
      <left_joint>wheel_lm</left_joint>
      <left_joint>wheel_lf</left_joint>
      <right_joint>wheel_rr</right_joint>
      <right_joint>wheel_rm</right_joint>
      <right_joint>wheel_rf</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/mux/cmd_vel</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_lr</joint_name>
      <joint_name>wheel_rr</joint_name>
      <joint_name>left_rocker_joint</joint_name>
      <joint_name>right_rocker_joint</joint_name>
      <joint_name>joint_left_l_u</joint_name>
      <joint_name>joint_right_l_u</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ============================== SENSORS (ZED + IMU) ==============================
       Sensors sit on the ZED macro frames (<cam>_left/right_camera_frame, x forward = gz camera axis);
       frame_id in the messages is the matching optical frame. gz-sensors 10 reads <frame_id>
       (<gz_frame_id>/<ignition_frame_id> are deprecated/ignored). -->
  <xacro:macro name="zed_mono_camera" params="name side topic">
    <gazebo reference="${cam}_${side}_camera_frame">
      <sensor name="${name}" type="camera">
        <frame_id>${cam}_${side}_camera_frame_optical</frame_id>
        <update_rate>30</update_rate>
        <topic>${topic}/image_rect_color</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>20.0</far>
          </clip>
          <camera_info_topic>${topic}/camera_info</camera_info_topic>
          <!-- 0x3FFFFFFF: default (0xFFFFFFFF) sets the 2 top bits reserved by ogre2 -> warning every start -->
          <visibility_mask>1073741823</visibility_mask>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:zed_mono_camera name="camera_left"  side="left"  topic="/zed2/zed_node/left"/>
  <xacro:zed_mono_camera name="camera_right" side="right" topic="/zed2/zed_node/right"/>

  <gazebo reference="${cam}_left_camera_frame">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <frame_id>${cam}_left_camera_frame_optical</frame_id>
      <update_rate>30.0</update_rate>
      <topic>/zed2/zed_node/depth</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>6.0</far>
        </clip>
        <visibility_mask>1073741823</visibility_mask>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${cam}_camera_center">
    <sensor name="imu_sensor" type="imu">
      <frame_id>${cam}_camera_center</frame_id>
    </sensor>
  </gazebo>

</robot>
