    <joint name="wheel_lr" type="${continuous_type}">
      <parent link="left_suspension_u"/>
      <child link="wheel_link_LR"/>
      <origin xyz="-.36433 .1232 -.24967" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <dynamics damping="0.7"/>
      </xacro:if>
    </joint>

    <joint name="wheel_lf" type="${continuous_type}">
      <parent link="left_suspension_l"/>
      <child link="wheel_link_LF"/>
      <origin xyz=".20811 .1232 -.05573" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <dynamics damping="0.7"/>
        <mimic joint="wheel_lr"/>
      </xacro:if>
    </joint>

    <joint name="wheel_lm" type="${continuous_type}">
      <parent link="left_suspension_l"/>
      <child link="wheel_link_LM"/>
      <origin xyz="-.20807 .1232 -.05573" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <dynamics damping="0.7"/>
        <mimic joint="wheel_lr"/>
      </xacro:if>
    </joint>

    <joint name="wheel_rr" type="${continuous_type}">
      <parent link="right_suspension_u"/>
      <child link="wheel_link_RR"/>
      <origin xyz="-.36433 -.1232 -.24967" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
