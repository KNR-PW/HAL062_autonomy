        <dynamics damping="0.7"/>
        <mimic joint="wheel_rr"/>
      </xacro:if>
    </joint>

    <joint name="wheel_rm" type="${continuous_type}">
      <parent link="right_suspension_l"/>
      <child link="wheel_link_RM"/>
      <origin xyz="-.20807 -.1232 -.05573" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <dynamics damping="0.7"/>
        <mimic joint="wheel_rr"/>
      </xacro:if>
