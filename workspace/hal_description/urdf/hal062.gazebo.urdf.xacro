<?xml version="1.0"?>
<!-- Gazebo (Jetty) part of the HAL062 description: drive plugin, sensors, joint states.
     Included by hal062.urdf.xacro only when simulation:=true.
     World-level systems (Physics, Sensors, Imu, ...) live in the world SDF (hal_simulation/worlds),
     not here - loading them again from the robot would run them twice. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================== DRIVE ============================== -->
  <!-- NOTE: wheel_separation / wheel_radius kept from the original (1.2 / 0.15);
       geometric values are ~0.93 (2 * (rocker_joint_y + wheel_y)) and 0.1586. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_lr</left_joint>
      <left_joint>wheel_lm</left_joint>
      <left_joint>wheel_lf</left_joint>
      <right_joint>wheel_rr</right_joint>
      <right_joint>wheel_rm</right_joint>
      <right_joint>wheel_rf</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/mux/cmd_vel</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_lr</joint_name>
      <joint_name>wheel_rr</joint_name>
      <joint_name>left_rocker_joint</joint_name>
      <joint_name>right_rocker_joint</joint_name>
      <joint_name>joint_left_l_u</joint_name>
      <joint_name>joint_right_l_u</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ============================== SENSORS (ZED2 + IMU) ============================== -->
  <xacro:macro name="zed2_mono_camera" params="name y topic">
    <sensor name="${name}" type="camera">
      <frame_id>camera_frame</frame_id>
      <pose>0 ${y} 0 0 0 0</pose>
      <update_rate>30</update_rate>
      <topic>${topic}/image_rect_color</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
        <camera_info_topic>${topic}/camera_info</camera_info_topic>
        <!-- 0x3FFFFFFF: default (0xFFFFFFFF) sets the 2 top bits reserved by ogre2 -> warning every start -->
        <visibility_mask>1073741823</visibility_mask>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </xacro:macro>

  <gazebo reference="camera_frame">
    <pose>0 0 0 0 0 0</pose>

    <xacro:zed2_mono_camera name="camera_left"  y="${camera_baseline_half}"  topic="/zed2/zed_node/left"/>
    <xacro:zed2_mono_camera name="camera_right" y="${-camera_baseline_half}" topic="/zed2/zed_node/right"/>

    <sensor name="rgbd_camera" type="rgbd_camera">
      <frame_id>camera_frame</frame_id>
      <pose>0 ${camera_baseline_half} 0 0 0 0</pose>
      <update_rate>30.0</update_rate>
      <topic>/zed2/zed_node/depth</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>6.0</far>
        </clip>
        <!-- 0x3FFFFFFF: default (0xFFFFFFFF) sets the 2 top bits reserved by ogre2 -> warning every start -->
        <visibility_mask>1073741823</visibility_mask>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>

    <sensor name="imu_sensor" type="imu">
      <frame_id>camera_frame</frame_id>
    </sensor>
  </gazebo>

</robot>
