    <!-- LEFT SUSPENSION LOWER -->
    <link name="left_suspension_l">
      
      <inertial>
        <origin
          xyz="-0.0865766790595161 -0.108463241781581 0.0208855225858935"
          rpy="0 0 0" />
        <mass
