<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <!-- LINKS -->
    <!-- LEFT SUSPENSION UPPER -->
    <link name="left_suspension_u">
      <inertial>
        <origin
          xyz="-0.0865766790595161 -0.108463241781581 0.0208855225858935"
          rpy="0 0 0" />
        <mass
          value="1.74870167456714" />
        <inertia
          ixx="0.00252926248276328"
          ixy="0.00127733229620527"
          ixz="1.24274647762414E-06"
          iyy="0.00471425892976128"
          iyz="-1.95968906207085E-06"
          izz="0.00649623539246" />
      </inertial>
      <visual>
        <origin
          xyz="-0.425 0.2 -0.31"
          rpy="1.5707 0 0" />
        <geometry>
          <mesh filename="package://hal_description/meshes/zawieszenie_lewo.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="-0.2 0.023 -0.12"
          rpy="0 -0.680678 0" />
        <geometry>
          <box size=".375 .04 .04" />
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="0.15 0.023 -0.067"
          rpy="0 0.61749749 0" />
        <geometry>
          <box size=".239 .04 .04" />
        </geometry>
      </collision>
    </link>

