    <joint name="left_rocker_joint" type="${revolute_type}">
      <parent link="chassis"/>
      <child link="left_suspension_u"/>
      <xacro:if value="$(arg simulation)">
        <origin xyz=".25 .34 .035" rpy="0 -0.26 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
        <dynamics friction="1.0" damping="0.1"/>
      </xacro:if>
      <xacro:unless value="$(arg simulation)">
        <origin xyz=".25 .34 .035" rpy="0 0 0"/>
      </xacro:unless>
    </joint>

    <!-- TODO : FIXED FOR NOW -->
    <joint name="right_rocker_joint" type="${revolute_type}">
      <parent link="chassis"/>
      <child link="right_suspension_u"/>
      <xacro:if value="$(arg simulation)">
        <origin xyz=".25 -.34 .035" rpy="0 -0.26 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.7"/>
        <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
        <dynamics friction="1.0" damping="0.1"/>
      </xacro:if>
      <xacro:unless value="$(arg simulation)">
        <origin xyz=".25 -.34 .035" rpy="0 0 0"/>
      </xacro:unless>
    </joint>


    <joint name="joint_left_l_u" type="${revolute_type}">
      <parent link="left_suspension_u"/>
      <child link="left_suspension_l"/>
      <origin xyz=".257 0 -.19166" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
        <dynamics damping="0.7"/>
      </xacro:if>
    </joint>

    <joint name="joint_right_l_u" type="${revolute_type}">
      <parent link="right_suspension_u"/>
      <child link="right_suspension_l"/>
      <origin xyz=".257 0 -.19166" rpy="0 0 0"/>
      <xacro:if value="$(arg simulation)">
        <axis xyz="0 1 0"/>
        <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
        <dynamics damping="0.7"/>
      </xacro:if>
    </joint>










