<?xml version="1.0"?>
<!-- All numbers of the HAL062 description. Values ported 1:1 from hal2022 hal_main/description/*.xacro
     (CAD export), units: m, kg, rad. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================== MESHES ============================== -->
  <xacro:property name="mesh_dir" value="package://hal_description/meshes"/>
  <xacro:property name="mesh_chassis"            value="${mesh_dir}/visual/kadlub.dae"/>
  <xacro:property name="mesh_rocker_left"        value="${mesh_dir}/visual/zawieszenie_lewo.dae"/>
  <xacro:property name="mesh_rocker_right"       value="${mesh_dir}/visual/zawieszenie_prawo.dae"/>
  <xacro:property name="mesh_bogie_left"         value="${mesh_dir}/visual/zawieszenie_dol_lewe.dae"/>
  <xacro:property name="mesh_bogie_right"        value="${mesh_dir}/visual/zawieszenie_dol_prawe.dae"/>
  <!-- Original: left wheels use kolo_prawe, right wheels use kolo_lewe (kept as is) -->
  <xacro:property name="mesh_wheel_left_side"    value="${mesh_dir}/visual/kolo_prawe.dae"/>
  <xacro:property name="mesh_wheel_right_side"   value="${mesh_dir}/visual/kolo_lewe.dae"/>
  <!-- Original uses the STL as the camera visual -->
  <xacro:property name="mesh_zed2"               value="${mesh_dir}/collision/ZED2.STL"/>

  <!-- CAD meshes are exported Y-up; this rotates them into the link frame -->
  <xacro:property name="mesh_rpy" value="1.5707 0 0"/>

  <!-- ============================== CHASSIS ============================== -->
  <xacro:property name="chassis_height_above_ground" value="0.3564"/>  <!-- base_footprint -> chassis -->

  <xacro:property name="chassis_mass" value="20.1571429958443"/>
  <xacro:property name="chassis_com"  value="-0.0865766790595161 -0.108463241781581 0.0208855225858935"/>
  <xacro:property name="chassis_ixx"  value="0.165235848795832"/>
  <xacro:property name="chassis_ixy"  value="-0.000735581298441556"/>
  <xacro:property name="chassis_ixz"  value="-0.00199690921071345"/>
  <xacro:property name="chassis_iyy"  value="0.094167079648996"/>
  <xacro:property name="chassis_iyz"  value="-6.70970536592532E-05"/>
  <xacro:property name="chassis_izz"  value="0.219751038279827"/>

  <xacro:property name="chassis_visual_xyz"     value="-0.2825 0.330 -0.0915"/>
  <xacro:property name="chassis_collision_size" value="0.608 0.561 0.1763"/>

  <!-- ============================== SUSPENSION ==============================
       rocker = upper suspension arm (<side>_suspension_u), attached to the chassis, carries the rear wheel
       bogie  = lower suspension arm (<side>_suspension_l), attached to the rocker, carries front + middle wheel
       NOTE: rocker and bogie inertials reuse the chassis CoM offset - copy-paste in the original CAD export. -->
  <xacro:property name="suspension_mass" value="1.74870167456714"/>
  <xacro:property name="suspension_com"  value="-0.0865766790595161 -0.108463241781581 0.0208855225858935"/>
  <xacro:property name="suspension_ixx"  value="0.00252926248276328"/>
  <xacro:property name="suspension_ixy"  value="0.00127733229620527"/>
  <xacro:property name="suspension_ixz"  value="1.24274647762414E-06"/>
  <xacro:property name="suspension_iyy"  value="0.00471425892976128"/>
  <xacro:property name="suspension_iyz"  value="-1.95968906207085E-06"/>
  <xacro:property name="suspension_izz"  value="0.00649623539246"/>

  <xacro:property name="suspension_arm_width" value="0.04"/>  <!-- square cross-section of collision boxes -->

  <!-- Joint limits (simulation only; on the real robot the joints are fixed) -->
  <xacro:property name="suspension_lower_limit" value="-0.24"/>
  <xacro:property name="suspension_upper_limit" value="0.24"/>
  <xacro:property name="suspension_effort"      value="100.0"/>
  <xacro:property name="suspension_velocity"    value="100.0"/>

  <!-- Rocker: chassis -> rocker joint (y mirrored per side) -->
  <xacro:property name="rocker_joint_x" value="0.25"/>
  <xacro:property name="rocker_joint_y" value="0.34"/>
  <xacro:property name="rocker_joint_z" value="0.035"/>
  <xacro:property name="rocker_joint_pitch_sim" value="-0.26"/>  <!-- real robot: 0 -->

  <!-- Rocker collision: rear arm + front arm -->
  <xacro:property name="rocker_rear_arm_x"      value="-0.2"/>
  <xacro:property name="rocker_rear_arm_z"      value="-0.12"/>
  <xacro:property name="rocker_rear_arm_pitch"  value="-0.680678"/>
  <xacro:property name="rocker_rear_arm_length" value="0.375"/>
  <xacro:property name="rocker_front_arm_x"      value="0.15"/>
  <xacro:property name="rocker_front_arm_z"      value="-0.067"/>
  <xacro:property name="rocker_front_arm_pitch"  value="0.61749749"/>
  <xacro:property name="rocker_front_arm_length" value="0.239"/>

  <!-- Per-side rocker values. NOTE: in the original the collision y offsets and the joint dynamics
       are NOT mirrored between sides (right rocker had two <dynamics> tags, URDF parsers use the first one).
       Kept exactly as the original behaved - check against the real robot. -->
  <xacro:property name="rocker_left_visual_xyz"     value="-0.425 0.2 -0.31"/>
  <xacro:property name="rocker_left_rear_arm_y"     value="0.023"/>
  <xacro:property name="rocker_left_front_arm_y"    value="0.023"/>
  <xacro:property name="rocker_left_friction"       value="1.0"/>
  <xacro:property name="rocker_left_damping"        value="0.1"/>

  <xacro:property name="rocker_right_visual_xyz"    value="-0.425 0.33 -0.31"/>
  <xacro:property name="rocker_right_rear_arm_y"    value="-0.023"/>
  <xacro:property name="rocker_right_front_arm_y"   value="0.023"/>
  <xacro:property name="rocker_right_friction"      value="0.0"/>
  <xacro:property name="rocker_right_damping"       value="0.7"/>

  <!-- Bogie: rocker -> bogie joint -->
  <xacro:property name="bogie_joint_xyz" value="0.257 0 -0.19166"/>
  <xacro:property name="bogie_damping"   value="0.7"/>

  <!-- Bogie collision: two arms, symmetric in x -->
  <xacro:property name="bogie_arm_x"      value="0.1"/>
  <xacro:property name="bogie_arm_y"      value="-0.023"/>  <!-- same on both sides in the original -->
  <xacro:property name="bogie_arm_z"      value="-0.023"/>
  <xacro:property name="bogie_arm_pitch"  value="0.33161256"/>
  <xacro:property name="bogie_arm_length" value="0.170"/>

  <xacro:property name="bogie_left_visual_xyz"  value="-0.27 0.204 -0.12"/>
  <xacro:property name="bogie_right_visual_xyz" value="-0.27 0.33 -0.12"/>

  <!-- ============================== WHEELS ============================== -->
  <xacro:property name="wheel_radius" value="0.1586"/>
  <xacro:property name="wheel_width"  value="0.1255"/>
  <xacro:property name="wheel_damping" value="0.7"/>

  <xacro:property name="wheel_mass" value="2.66450210979718"/>
  <xacro:property name="wheel_com"  value="2.60676627017453E-06 0.00095092519030926 0.0107118731763976"/>
  <xacro:property name="wheel_ixx"  value="0.0120626849324792"/>
  <xacro:property name="wheel_ixy"  value="-2.34555238785698E-06"/>
  <xacro:property name="wheel_ixz"  value="-4.66555675956134E-07"/>
  <xacro:property name="wheel_iyy"  value="0.0120247000743743"/>
  <xacro:property name="wheel_iyz"  value="0.000163335836171467"/>
  <xacro:property name="wheel_izz"  value="0.0199434523384737"/>

  <xacro:property name="wheel_visual_xyz"    value="-0.1730 0.059 -0.1730"/>
  <xacro:property name="wheel_collision_rpy" value="1.5707 1.5707 0"/>

  <!-- Wheel joint positions relative to their parent arm (y mirrored per side) -->
  <xacro:property name="wheel_y" value="0.1232"/>
  <xacro:property name="wheel_rear_x"   value="-0.36433"/>  <!-- on the rocker -->
  <xacro:property name="wheel_rear_z"   value="-0.24967"/>
  <xacro:property name="wheel_front_x"  value="0.20811"/>   <!-- on the bogie -->
  <xacro:property name="wheel_middle_x" value="-0.20807"/>  <!-- on the bogie -->
  <xacro:property name="wheel_bogie_z"  value="-0.05573"/>

  <!-- ============================== CAMERA (ZED2) ============================== -->
  <xacro:property name="camera_xyz" value="0.342 0 0.1"/>  <!-- chassis -> camera_frame -->
  <xacro:property name="camera_baseline_half" value="0.06"/>  <!-- left/right optical frame y -->
  <xacro:property name="optical_rpy" value="-1.5708 0 -1.5708"/>  <!-- REP 103 optical frame -->

</robot>
